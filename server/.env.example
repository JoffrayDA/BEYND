# Copy to .env and fill. App runs without a key (mock coach plan) but real
# goal analysis requires a valid Gemini API key (aistudio.google.com/apikey).
GEMINI_API_KEY=
# Optional — defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Hour (0–23, local time) when the game day starts: a tick at 1 h counts
# for the previous day. Defaults to 4.
DAY_START_HOUR=4
PORT=8787
# Password gate for putting the app online. Empty = no login (local dev).
APP_PASSWORD=
# Optional HMAC secret for session cookies (long random string). Empty =
# derived from APP_PASSWORD, so changing the password logs everyone out.
SESSION_SECRET=
# Optional: database file (default server/elo.db) and built client folder
# (default ../client/dist, served when it exists).
ELO_DB_PATH=
CLIENT_DIST=
